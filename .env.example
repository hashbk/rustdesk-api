# ============================================
# 应用配置
# ============================================

# 应用端口
PORT=3000

# 数据库配置
DATABASE_TYPE=sqlite
DATABASE_DATABASE=./data/rustdesk.db

# JWT 配置
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=7d

# ============================================
# 文件存储配置
# ============================================

# 文件上传根目录（绝对路径或相对路径）
UPLOAD_DIR=./uploads

# 下载 URL 前缀
DOWNLOAD_URL_PREFIX=/downloads

# 最大文件大小（字节，默认 500MB）
MAX_FILE_SIZE=524288000

# 允许的文件类型（逗号分隔）
ALLOWED_FILE_TYPES=exe,dmg,deb,rpm,apk,ipa,zip,tar,gz

# 是否启用归档功能
ENABLE_ARCHIVING=true

# 保留版本数量（旧版本自动清理）
KEEP_VERSION_COUNT=10

# 临时文件清理间隔（秒，默认 24小时）
TEMP_CLEANUP_INTERVAL=86400

# ============================================
# 速率限制配置
# ============================================

# 版本检查接口速率限制（每分钟请求次数）
VERSION_CHECK_LIMIT=10

# 版本检查接口速率限制时间窗口（秒）
VERSION_CHECK_TTL=60

# 文件下载速率限制（每分钟下载次数）
DOWNLOAD_MAX_REQUESTS=5

# 文件下载速率限制时间窗口（毫秒）
DOWNLOAD_WINDOW_MS=60000

# ============================================
# Release 同步认证配置
# ============================================

# Release 同步 Token（用于 GitHub Action 认证）
# 生成方法: openssl rand -base64 32
RELEASE_SYNC_TOKEN=your-secure-random-token-here

# ============================================
# 其他配置
# ============================================

# 日志级别
LOG_LEVEL=info

# 是否启用调试模式
DEBUG=false
